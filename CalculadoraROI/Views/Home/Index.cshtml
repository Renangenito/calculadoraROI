@model CalculadoraROI.Models.Calculadora

@{
    ViewData["Title"] = "Index";
}

<div class="row d-flex flex-row justify-content-between">
    <div class="video mt-5 mb-5 " style="max-width: 750px; max-height: 500px;">
        <iframe class="mt-5" width="100%" height="100%" src="https://www.youtube.com/embed/vlW63OfDxh0" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>

    <div class="col-md-4 rounded p-5 mt-5" style="background-color: #ffffff;">
        <h5 class="fw-bold">Calculadora - ROI</h5>
        <p class="fw-bold" style="color: #938f8f; font-size: 0.8em; ">Preencha os campos abaixo e nosso time entrará em contato enviando o cálculo via email:</p>
        <form asp-action="Index">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Id" class="form-control border-0" style="background-color: #e5e5e5;" hidden />

            <div class="form-group">
                <label asp-for="Nome" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <input asp-for="Nome" class="form-control border-0 p-0 mb-3" style="background-color: #e5e5e5;" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Email" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <input asp-for="Email" type="email" class="form-control border-0 p-0 mb-3" style="background-color: #e5e5e5;" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Empresa" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <input asp-for="Empresa" class="form-control border-0 p-0 mb-3" style="background-color: #e5e5e5;" />
                <span asp-validation-for="Empresa" class="text-danger"></span>
            </div>

            <div class="form-group d-flex flex-column">
                <label asp-for="Segmento" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <select asp-for="Segmento" class="border-0 p-0 mb-3" style="background-color: #e5e5e5; outline: 0; color: #666666;">
                    <option disabled selected value="segmento">Selecione</option>
                    <option value="Financeiro">Financeiro</option>
                    <option value="Varejo">Varejo</option>
                    <option value="Digital">Digital</option>
                    <option value="Corban">Corban</option>
                    <option value="Motor">Motor</option>
                    <option value="Outros">Outros</option>
                </select>
            </div>

            <div class="form-group d-flex flex-column">
                <label asp-for="AreaAtuacao" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <select asp-for="AreaAtuacao" class="border-0 p-0 mb-3" style="background-color: #e5e5e5; outline: 0; color: #666666;">
                    <option disabled selected value="Área de Atuacao">Selecione</option>
                    <option value="Nacional">Nacional</option>
                    <option value="AC">AC</option>
                    <option value="AL">AL</option>
                    <option value="AM">AM</option>
                    <option value="AP">AP</option>
                    <option value="BA">BA</option>
                    <option value="CE">CE</option>
                    <option value="DF">DF</option>
                    <option value="ES">ES</option>
                    <option value="GO">GO</option>
                    <option value="MA">MA</option>
                    <option value="MG">MG</option>
                    <option value="MS">MS</option>
                    <option value="MT">MT</option>
                    <option value="PA">PA</option>
                    <option value="PB">PB</option>
                    <option value="PE">PE</option>
                    <option value="PI">PI</option>
                    <option value="PR">PR</option>
                    <option value="RJ">RJ</option>
                    <option value="RN">RN</option>
                    <option value="RS">RS</option>
                    <option value="RO">RO</option>
                    <option value="RR">RR</option>
                    <option value="SC">SC</option>
                    <option value="SE">SE</option>
                    <option value="SP">SP</option>
                    <option value="TO">TO</option>
                </select>
            </div>

            <div class="form-group d-flex flex-column">
                <label asp-for="Onboarding" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <select asp-for="Onboarding" class="border-0 p-0 mb-3" style="background-color: #e5e5e5; outline: 0; color: #666666;">
                    <option disabled selected value="onboarding">Selecione</option>
                    <option value="Físico + Digital">Físico + Digital</option>
                    <option value="Físico"> Físico</option>
                    <option value="Digital">Digital</option>
                </select>
            </div>
            <hr class="mt-4 mb-4" />
            
            <div class="form-group d-flex flex-column">
                <label asp-for="ConsultaMes" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <select asp-for="ConsultaMes" class="border-0 p-0 mb-3" style="background-color: #e5e5e5; outline: 0; color: #666666;">
                    <option disabled selected value="consultaMes">Selecione</option>
                    <option value="100">100</option>
                    <option value="200">200</option>
                    <option value="300">300</option>
                    <option value="400">400</option>
                    <option value="500">500</option>
                    <option value="600">600</option>
                    <option value="700">700</option>
                    <option value="800">800</option>
                    <option value="900">900</option>
                    <option value="1000">1000</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="TicketMedio" class="control-label pb-1" style="font-size: 0.8em; color: #666666;"></label>
                <input asp-for="TicketMedio" id="money" class="money form-control border-0 p-0 mb-3 " style="background-color: #e5e5e5;" />
                <span asp-validation-for="TicketMedio" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Calcular ROI" class="btn btn-primary" />
            </div>
            <script src="~/js/site.js" asp-append-version="true"></script>

        </form>
    </div>
</div>


